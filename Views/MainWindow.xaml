<Window x:Class="ImageGalleryApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ImageGalleryApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        Title="Image Gallery Manager" Height="800" Width="1200"
        Icon="/icon.ico"
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="800">

    <Window.Resources>
        <Style x:Key="ImageBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKept}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavorited}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FavoriteBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlacklisted}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Panel.ZIndex" Value="100"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Visibility" Value="Visible"/>
        </Style>
        <Style x:Key="TopNavToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Visibility" Value="Visible"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Border Grid.Row="0" Padding="5" Background="{StaticResource EditorBackgroundBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Donate ❤️" ToolTip="https://ko-fi.com/moliminous" Command="{Binding OpenDonateLinkCommand}" Margin="5,0"/>
                    <Button Content="GitHub" ToolTip="https://github.com/carelesswhisp" Command="{Binding OpenGitHubLinkCommand}" Margin="5,0,10,0"/>
                </StackPanel>

                <WrapPanel>
                    <Button Content="Select Folder" Command="{Binding SelectFolderCommand}" Style="{StaticResource TopNavButtonStyle}"/>
                    <Button Content="Load Images" Command="{Binding LoadRandomImagesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Margin" Value="5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavoritesViewActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="View Favorites" Command="{Binding ViewFavoritesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavoritesViewActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Back to Browse" Command="{Binding BackToBrowseCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavoritesViewActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Reroll" Command="{Binding RerollCommand}" Style="{StaticResource TopNavButtonStyle}"/>
                    <Button Content="Save Kept" Command="{Binding SaveSelectedCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFapRouletteMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavoritesViewActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Elimination Round" Command="{Binding StartEliminationCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFapRouletteMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavoritesViewActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Separator Margin="10,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                    <ToggleButton Content="Fap Roulette" IsChecked="{Binding IsFapRouletteMode, Mode=TwoWay}" Style="{StaticResource TopNavToggleStyle}"/>
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Margin="5"/>
                    <TextBlock Text="{Binding SelectedFolderPath}" VerticalAlignment="Center" Margin="15,0" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Main Image Grid -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="5,0,5,5">
                <ItemsControl ItemsSource="{Binding DisplayedImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ImageBorderStyle}" Width="{Binding DataContext.Settings.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.Settings.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                  Command="{Binding DataContext.ShowFullImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid ClipToBounds="True" Background="Transparent">
                                    <Image>
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Source" Value="{Binding Thumbnail}" />
                                                <Setter Property="Stretch" Value="UniformToFill" />
                                                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Stretch" Value="Uniform"/>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.1" Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.1" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Overlay buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                                        <!-- Keep Button -->
                                        <Button Command="{Binding DataContext.ToggleKeepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Keep Image">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Width" Value="48"/>
                                                    <Setter Property="Height" Value="48"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="FontSize" Value="24"/>
                                                    <Setter Property="Content" Value="✔️"/>
                                                    <Setter Property="Background" Value="#A04CAF50"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding DataContext.IsFapRouletteMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                                <Condition Binding="{Binding DataContext.IsFavoritesViewActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsKept}" Value="False">
                                                            <Setter Property="Background" Value="#A0555555"/>
                                                            <Setter Property="Content" Value="👍"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- Favorite Button -->
                                        <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Favorite Image">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Width" Value="48"/>
                                                    <Setter Property="Height" Value="48"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="FontSize" Value="24"/>
                                                    <Setter Property="Content" Value="❤️"/>
                                                    <Setter Property="Background" Value="#A0E91E63"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsFapRouletteMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsFavoritesViewActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFavorited}" Value="False">
                                                            <Setter Property="Background" Value="#A0555555"/>
                                                            <Setter Property="Content" Value="🤍"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- Blacklist Button -->
                                        <Button Width="48" Height="48" Padding="0" Margin="5,0,0,0"
                            Command="{Binding DataContext.ToggleBlacklistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Blacklist Image">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="FontSize" Value="24"/>
                                                    <Setter Property="Content" Value="✖️"/>
                                                    <Setter Property="Background" Value="#A0F44336"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBlacklisted}" Value="False">
                                                            <Setter Property="Background" Value="#A0555555"/>
                                                            <Setter Property="Content" Value="👎"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <!-- File name -->
                                    <Border VerticalAlignment="Bottom" Background="#D0000000" Padding="5,2">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- No Images Message -->
            <TextBlock Text="Select a folder and click 'Load Images' to begin."
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"
                 Foreground="{StaticResource BorderBrush}"
                 Visibility="{Binding DisplayedImages.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"/>

            <!-- Loading Indicator -->
            <Border Background="#A0000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="300" Height="25"/>
                    <TextBlock Text="Loading Images..." FontSize="16" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem Content="{Binding StatusText}"/>
        </StatusBar>
    </Grid>
</Window>