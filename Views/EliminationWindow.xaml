<Window x:Class="ImageGalleryApp.Views.EliminationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elimination Round" Height="550" Width="900"
        WindowStartupLocation="CenterOwner" MinHeight="400" MinWidth="600">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Choose your preferred image from each pair"
               HorizontalAlignment="Center"
               Margin="0,15,0,10"
               FontSize="18"
               FontWeight="SemiBold"/>

    <Grid Grid.Row="1" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              x:Name="LeftImageButton"
              Click="LeftImageButton_Click"
              Margin="10" Padding="0" BorderThickness="2" BorderBrush="{StaticResource BorderBrush}">
        <Image x:Name="LeftImage" Stretch="Uniform"/>
      </Button>

      <GridSplitter Grid.Column="1" Width="5" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

      <Button Grid.Column="2"
              x:Name="RightImageButton"
              Click="RightImageButton_Click"
              Margin="10" Padding="0" BorderThickness="2" BorderBrush="{StaticResource BorderBrush}">
        <Image x:Name="RightImage" Stretch="Uniform"/>
      </Button>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource EditorBackgroundBrush}" Padding="10">
      <Grid>
        <TextBlock x:Name="ProgressText" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
        <Button Content="Cancel" Width="100" Margin="0,0,10,0" Click="Cancel_Click" HorizontalAlignment="Right"/>
      </Grid>
    </Border>
  </Grid>
</Window>